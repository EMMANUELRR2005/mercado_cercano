// Copia este archivo a ios/Flutter/Secrets.xcconfig (NO se versiona) y pon
// tu Google Maps API key para iOS. Se expone como $(MAPS_API_KEY) en
// Info.plist (clave GMSApiKey) y AppDelegate la lee de ahí.
//
// Restringe la key en Google Cloud Console por bundle id de iOS.
MAPS_API_KEY=YOUR_IOS_MAPS_API_KEY
